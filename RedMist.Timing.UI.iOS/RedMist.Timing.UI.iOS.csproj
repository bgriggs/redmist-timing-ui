<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0-ios</TargetFramework>
		<SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ProvisioningType>manual</ProvisioningType>
		<CodesignProvision>RedMist</CodesignProvision>
		<ApplicationTitle>Red Mist Timing</ApplicationTitle>
		<ApplicationId>com.bigmission.redmist</ApplicationId>
		<ApplicationVersion>$(SharedVersion)</ApplicationVersion>
		<RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
		
		<!-- Preserve MessagePack types for AOT compilation -->
		<TrimMode>partial</TrimMode>
		<MtouchExtraArgs>$(MtouchExtraArgs) --optimize=-remove-dynamic-registrar</MtouchExtraArgs>
	</PropertyGroup>

	<!-- Debug symbol upload. Turns itself on only when CI supplies SENTRY_AUTH_TOKEN, so local and
	     PR builds are untouched. sentry-cli reads the token, org and project from the environment
	     rather than MSBuild properties, keeping the token off the command line. A bad token or an
	     unreachable server downgrades to a build warning and skips the upload, so a Sentry outage
	     cannot fail a release. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(SENTRY_AUTH_TOKEN)' != ''">
		<SentryUploadSymbols>true</SentryUploadSymbols>
		<!-- Symbols only. SentryUploadSources would also bundle and upload the source itself, which
		     is not needed for readable frames and is a disclosure decision rather than a build one. -->
		<SentryUploadSources>false</SentryUploadSources>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)'=='Release|net9.0-ios'">
		<EnableAssemblyILStripping>False</EnableAssemblyILStripping>
		<!-- Ensure MessagePack types are preserved -->
		<TrimMode>partial</TrimMode>
	</PropertyGroup>
	
	<ItemGroup>
		<!-- Preserve MessagePack assemblies from trimming -->
		<TrimmerRootAssembly Include="MessagePack" />
		<TrimmerRootAssembly Include="MessagePack.Annotations" />
		<!-- Allow the trimmer to drop unused types from TimingCommon (notably TypeScript codegen specs that reach into TypeGen) -->
		<TrimmableAssembly Include="RedMist.TimingCommon" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.iOS" />
		<!-- TypeGen is a build-time TS codegen library transitively pulled in by RedMist.TimingCommon.
		     Strip it from the iOS publish so AOT never tries to compile TypeGen.Core (which uses reflection patterns AOT can't handle). -->
		<PackageReference Include="TypeGen" ExcludeAssets="all" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\RedMist.Timing.UI\RedMist.Timing.UI.csproj" />
	</ItemGroup>
	
	<ItemGroup>
		<BundleResource Include="Resources/Launch.storyboard" />
	</ItemGroup>
	
</Project>
