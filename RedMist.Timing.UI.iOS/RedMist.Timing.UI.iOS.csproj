<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0-ios</TargetFramework>
		<SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ProvisioningType>manual</ProvisioningType>
		<CodesignProvision>RedMist</CodesignProvision>
		<ApplicationTitle>Red Mist Timing</ApplicationTitle>
		<ApplicationId>com.bigmission.redmist</ApplicationId>
		<ApplicationVersion>$(SharedVersion)</ApplicationVersion>
		<RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
		
		<!-- Preserve MessagePack types for AOT compilation -->
		<TrimMode>partial</TrimMode>
		<MtouchExtraArgs>$(MtouchExtraArgs) --optimize=-remove-dynamic-registrar</MtouchExtraArgs>
	</PropertyGroup>

	<!-- Debug symbol upload. Turns itself on only when CI supplies SENTRY_AUTH_TOKEN, so local and
	     PR builds are untouched. sentry-cli reads the token, org and project from the environment
	     rather than MSBuild properties, keeping the token off the command line. A bad token or an
	     unreachable server downgrades to a build warning and skips the upload, so a Sentry outage
	     cannot fail a release. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(SENTRY_AUTH_TOKEN)' != ''">
		<SentryUploadSymbols>true</SentryUploadSymbols>
		<!-- Symbols only. SentryUploadSources would also bundle and upload the source itself, which
		     is not needed for readable frames and is a disclosure decision rather than a build one. -->
		<SentryUploadSources>false</SentryUploadSources>
	</PropertyGroup>

	<ItemGroup>
		<!-- Preserve MessagePack assemblies from trimming -->
		<TrimmerRootAssembly Include="MessagePack" />
		<TrimmerRootAssembly Include="MessagePack.Annotations" />
		<!-- RedMist.TimingCommon deliberately carries no TrimmableAssembly line, matching the Android
		     head. It had one, to drop the TypeScript codegen specs that reached into TypeGen, and
		     TimingCommon 1.17.2 no longer ships those specs at all - so the line kept only its side
		     effect.

		     Measured on a Mac against ios-arm64, which is the only place this linker actually runs.
		     With the line, both MessagePack patch formatters come out of ILLink as empty shells:

		         SessionStatePatchFormatter   methods:  fields:  interfaces: 0

		     and without it they are whole:

		         SessionStatePatchFormatter   methods: Serialize, Deserialize, .ctor, .cctor
		                                      fields: Instance   interfaces: 2

		     The type survives either way, because [MessagePackFormatter(typeof(...))] names it and
		     that attribute has no DynamicallyAccessedMembers - so AttributeFormatterResolver would
		     find the shell and fail to activate it. That is the failure the Android head describes
		     at length, and it cost 48 KB of IL in the linked assembly to cause.

		     Nothing was observably broken here, and that is the point: this hub runs JSON, so iOS
		     never asks MessagePack for these types and the damage stayed latent - live until the day
		     iOS moves to the MessagePack protocol. Removing the line costs about 45 KB on a 39 MB
		     IPA, roughly a tenth of a percent, verified running on an iPhone XR. -->
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.iOS" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\RedMist.Timing.UI\RedMist.Timing.UI.csproj" />
	</ItemGroup>
	
	<ItemGroup>
		<BundleResource Include="Resources/Launch.storyboard" />
	</ItemGroup>
	
</Project>
